# ForgeLine Technologies — environment variables
#
# Copy to .env and fill in real values. Never commit .env; it is gitignored.
# Names only below — no defaults, no placeholders that could be mistaken for
# working values.

# --- Database ---------------------------------------------------------------
# Neon pooled connection string. Read at BUILD time as well as runtime, so a
# missing value fails the deploy rather than shipping a broken data layer.
DATABASE_URL=

# --- Sessions ---------------------------------------------------------------
# Reserved for authentication, which is not implemented yet. Generate with:
#   openssl rand -base64 32
SESSION_SECRET=

# --- Email (Resend) ---------------------------------------------------------
# Free tier: 3,000/month, 100/day. https://resend.com
#
# RESEND_API_KEY  Without it BOTH the notification and the confirmation are
#                 skipped. Enquiries are still stored.
# CONTACT_EMAIL   Inbox that receives new enquiries. The notification is
#                 skipped unless this is set as well as the API key.
# RESEND_FROM     Sender identity, e.g. "ForgeLine <hello@yourdomain.com>".
#                 The domain must be verified in Resend, otherwise delivery
#                 is limited to your own account address.
RESEND_API_KEY=
CONTACT_EMAIL=
RESEND_FROM=

# --- Site ------------------------------------------------------------------
# Canonical public origin, e.g. https://forgelinetechnologies.com
# Used for canonical URLs, Open Graph and the sitemap. Falls back to the value
# in src/lib/site.ts when unset, so a missing value degrades rather than breaks.
NEXT_PUBLIC_SITE_URL=
