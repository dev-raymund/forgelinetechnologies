# ForgeLine Technologies — environment variables
#
# Copy to .env and fill in real values. Never commit .env; it is gitignored.
# Names only below — no defaults, no placeholders that could be mistaken for
# working values.

# --- Database ---------------------------------------------------------------
# Neon pooled connection string. Read at BUILD time as well as runtime, so a
# missing value fails the deploy rather than shipping a broken data layer.
DATABASE_URL=

# --- Sessions ---------------------------------------------------------------
# Reserved for authentication, which is not implemented yet. Generate with:
#   openssl rand -base64 32
SESSION_SECRET=

# --- Email (Resend) ---------------------------------------------------------
#
# THE KEY POINT: the address in RESEND_FROM never receives anything. It is a
# sending identity only. You do NOT need Google Workspace, a paid mailbox, or
# any mailbox at all behind it — you only need the DOMAIN verified in Resend.
#
# RESEND_API_KEY  Server-side only. Without it both emails are skipped and the
#                 enquiry is still stored.
#
# CONTACT_EMAIL   Where enquiry notifications are DELIVERED. A personal Gmail
#                 is fine: it is never rendered on the site, never in metadata,
#                 and never sent to a visitor. Notifications carry the
#                 visitor's address as Reply-To, so hitting reply answers the
#                 lead directly.
#
# RESEND_FROM     The verified sending identity, with a display name:
#                   Forgeline Technologies <notifications@forgelinetechnologies.com>
#                 The domain must show as Verified in Resend. Until it does,
#                 sends fail and the failure is logged with what to do about
#                 it — the enquiry is still saved either way.
#
# REPLY_TO        Optional. Where a visitor's reply to their own confirmation
#                 goes. Defaults to CONTACT_EMAIL so replies are never lost.
#                 Set it once you have a forwarded branded address, to keep a
#                 personal address off a header visitors can see.
RESEND_API_KEY=
CONTACT_EMAIL=
RESEND_FROM=
REPLY_TO=

# --- Site ------------------------------------------------------------------
# Canonical public origin, e.g. https://forgelinetechnologies.com
# Used for canonical URLs, Open Graph and the sitemap. Falls back to the value
# in src/lib/site.ts when unset, so a missing value degrades rather than breaks.
NEXT_PUBLIC_SITE_URL=

# --- Public contact address ---------------------------------------------------
# OPTIONAL, and separate from CONTACT_EMAIL on purpose.
#
# This one is PUBLISHED — footer, contact page, structured data, and every
# scraper that visits. There is no fallback: leave it empty and the site shows
# no mailbox at all, routing people to the contact form instead. That is the
# right default while the only address available is a personal one.
#
# Set it only when you have an address you are happy to publish.
NEXT_PUBLIC_CONTACT_EMAIL=

# --- Analytics ----------------------------------------------------------------
# All optional; each script only loads when its variable is set, so an unset
# value ships no third-party JavaScript at all.
#
# NEXT_PUBLIC_GA_ID       Google Analytics 4, e.g. G-XXXXXXXXXX
# NEXT_PUBLIC_GTM_ID      Google Tag Manager, e.g. GTM-XXXXXXX
# NEXT_PUBLIC_CLARITY_ID  Microsoft Clarity project id
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_CLARITY_ID=

# Google Search Console verification token (the content= value of the
# google-site-verification meta tag). Leave empty if verifying by DNS.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
