# Neon Postgres connection string (free tier).
# Create a project at https://neon.tech -> copy the pooled connection string.
DATABASE_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# Random 32+ char string used to sign session cookies.
# Generate with:  openssl rand -base64 32
# Changing this signs out every user everywhere.
SESSION_SECRET=""

# BOOTSTRAP ONLY — used once by `npm run db:seed` to create the first admin
# account, and ignored after that. Accounts are managed at /admin/users.
# Generate the hash with:  npm run hash -- "your-password"
# Locked out? Run:  npm run user:add -- "email" "password" admin
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD_HASH=""

# --- Contact form (Resend) ---------------------------------------------
# Free tier: 3,000 emails/month, 100/day — https://resend.com
#
# RESEND_API_KEY   API key from the Resend dashboard. Without it BOTH the
#                  notification and the confirmation are skipped silently.
# CONTACT_EMAIL    Inbox that receives new enquiries. The notification is
#                  skipped unless this is set as well as the API key.
# RESEND_FROM      Sender identity, e.g. "Name <you@yourdomain.com>".
#                  The domain must be verified in Resend. If unset, the code
#                  falls back to Resend's shared onboarding sender, which only
#                  delivers to your own account address — fine for testing,
#                  not for client confirmations.
#
# Names only below. Never commit real values; set them in .env locally and in
# the hosting provider's environment variables for deployments.
RESEND_API_KEY=
CONTACT_EMAIL=
RESEND_FROM=
